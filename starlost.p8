pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 game_state="menu"
 map_w=312
 map_h=224
 x=63
 y=63
 direcao=1

 fruit_count=0
 sucata_count=0

 fruits={}
 max_fruits=4
 fruit_sprite=129

 idle={0,2,4,6,8}
 anda_frente={32,34,36,38,32,40,42,44}
 anda_costa={64,66,68,70,64,72,74,76}
 anda_lado={96,98,100,102,96,104,106,108}

 anim=idle
 frame=1
 tempo=0

 cx=0
 cy=0

 rocket_x=240
 rocket_y=160
 rocket_stage=1

 msg=""
 msg_timer=0

 ending_frame=1
 ending_timer=0

 npc_init()
 fruit_init()
end

function _update()
 if game_state=="menu" then
  if btnp(4) then
   game_state="playing"
  end
  return
 end

 if game_state=="ending" then
  ending_timer+=1
  if ending_timer>=6 then
   ending_timer=0
   ending_frame+=1
   if ending_frame>#anda_frente then
    ending_frame=1
   end
  end

  if btnp(4) then
   _init()
  end
  return
 end

 animation()
 npc_update()
 fruits_update()
 interaction_update()

 if msg_timer>0 then
  msg_timer-=1
 end
end

function _draw()
 cls(1)

 if game_state=="menu" then
  menu_draw()
  return
 end

 if game_state=="ending" then
  ending_draw()
  return
 end

 dcam()
 map()
 fruits_draw()
 rocket_draw()

 local sp=anim[frame]

 if direcao==-1 and anim==anda_lado then
  spr(sp,x,y,2,2,true)
 else
  spr(sp,x,y,2,2)
 end

 npc_draw()
 player_hint()

 camera()
 hud_draw()
end


function menu_draw()
 print("star lost",40,25,10)
 print("your ship is broken",20,40,7)
 print("explore the planet",22,55,6)
 print("collect fruits and",22,62,6)
 print("trade them for scrap",19,70,6)
 print("repair your rocket",21,92,7)
 print("press z to play",31,112,11)
end

function animation()
 local nova_anim=idle
 local andando=false

 if btn(0) then
  x-=1
  nova_anim=anda_lado
  direcao=-1
  andando=true
 end

 if btn(1) then
  x+=1
  nova_anim=anda_lado
  direcao=1
  andando=true
 end

 if btn(2) then
  y-=1
  nova_anim=anda_costa
  andando=true
 end

 if btn(3) then
  y+=1
  nova_anim=anda_frente
  andando=true
 end

 x=mid(0,x,map_w-16)
 y=mid(0,y,map_h-16)

 if nova_anim!=anim then
  anim=nova_anim
  frame=1
  tempo=0
 end

 tempo+=2

 if andando then
  if tempo>=6 then
   tempo=0
   frame+=1
   if frame>#anim then
    frame=1
   end
  end
 else
  if tempo>=8 then
   tempo=0
   frame+=1
   if frame>#anim then
    frame=1
   end
  end
 end
end

function dcam()
 cx=mid(0,x-63+8,map_w-128)
 cy=mid(0,y-63+8,map_h-128)
 camera(cx,cy)
end
-->8
function npc_init()
 anda_lado_npc={144,145,144,146}
 anda_frente_npc={160,161,160,162}
 anda_costa_npc={176,177,176,178}

 npcs={
  {x=45,y=45,color=8},
  {x=135,y=55,color=9},
  {x=270,y=45,color=10},
  {x=75,y=175,color=11},
  {x=190,y=180,color=12}
 }

 for n in all(npcs) do
  n.dir="lado"
  n.estado="andando"
  n.direcao=1
  n.vel=0.5
  n.tempo=30+flr(rnd(90))
  n.frame=1
  n.anim_tempo=0
 end
end

function npc_update()
 for n in all(npcs) do
  n.tempo-=1

  if n.tempo<=0 then
   local escolha=flr(rnd(5))

   if escolha==0 then
    n.estado="parado"
   elseif escolha==1 then
    n.estado="andando"
    n.dir="frente"
   elseif escolha==2 then
    n.estado="andando"
    n.dir="costa"
   elseif escolha==3 then
    n.estado="andando"
    n.dir="lado"
    n.direcao=1
   elseif escolha==4 then
    n.estado="andando"
    n.dir="lado"
    n.direcao=-1
   end

   n.tempo=30+flr(rnd(90))
  end

  if n.estado=="andando" then
   if n.dir=="frente" then
    n.y+=n.vel
   elseif n.dir=="costa" then
    n.y-=n.vel
   elseif n.dir=="lado" then
    n.x+=n.vel*n.direcao
   end

   n.anim_tempo+=1

   if n.anim_tempo>=6 then
    n.anim_tempo=0
    n.frame+=1
    if n.frame>4 then
     n.frame=1
    end
   end
  else
   n.frame=1
   n.anim_tempo=0
  end

  n.x=mid(0,n.x,map_w-8)
  n.y=mid(0,n.y,map_h-8)
 end
end

function npc_draw()
 for n in all(npcs) do
  local a

  if n.dir=="frente" then
   a=anda_frente_npc
  elseif n.dir=="costa" then
   a=anda_costa_npc
  else
   a=anda_lado_npc
  end

  pal(2,n.color)
  pal(13,n.color)

  spr(a[n.frame],n.x,n.y,1,1,
   n.dir=="lado" and n.direcao==-1)

  pal()
 end
end

function fruit_init()
 for i=1,max_fruits do
  spawn_fruit()
 end
end

function spawn_fruit()
 local fx=flr(rnd(map_w-8))
 local fy=flr(rnd(map_h-8))

 add(fruits,{x=fx,y=fy})
end

function fruits_update()
 for i=#fruits,1,-1 do
  local f=fruits[i]

  if x<f.x+8 and
     x+16>f.x and
     y<f.y+8 and
     y+16>f.y then

   fruit_count+=1
   deli(fruits,i)
   spawn_fruit()
  end
 end
end

function fruits_draw()
 for f in all(fruits) do
  spr(fruit_sprite,f.x,f.y)
 end
end

function perto(px,py,pw,ph,tx,ty,tw,th,m)
 return px<tx+tw+m and
        px+pw>tx-m and
        py<ty+th+m and
        py+ph>ty-m
end

function nearby_npc()
 for n in all(npcs) do
  if perto(x,y,16,16,n.x,n.y,8,8,12) then
   return n
  end
 end
 return nil
end

function near_rocket()
 return perto(x,y,16,16,rocket_x,rocket_y,16,32,12)
end

function interaction_update()
 if btnp(5) then
  local n=nearby_npc()

  if n then
   if fruit_count>=3 then
    fruit_count-=3
    sucata_count+=1
   else
    show_message("need 3 fruits to trade")
   end

  elseif near_rocket() then
   repair_rocket()
  end
 end

 if btnp(4) and
    rocket_stage==5 and
    near_rocket() then
  game_state="ending"
  ending_frame=1
  ending_timer=0
 end
end
-->8
function show_message(t)
 msg=t
 msg_timer=90
end

function repair_rocket()
 if rocket_stage>=5 then
  return
 end

 local custo=0

 if rocket_stage==1 then
  custo=2
 elseif rocket_stage==2 then
  custo=1
 elseif rocket_stage==3 then
  custo=2
 elseif rocket_stage==4 then
  custo=1
 end

 if sucata_count>=custo then
  sucata_count-=custo
  rocket_stage+=1
 else
  local falta=custo-sucata_count
  show_message("need "..falta.." more scrap")
 end
end

function rocket_draw()
 local corpo=131
 local base=163

 if rocket_stage==2 then
  corpo=133
  base=165
 elseif rocket_stage==3 then
  corpo=135
  base=167
 elseif rocket_stage==4 then
  corpo=137
  base=169
 elseif rocket_stage==5 then
  corpo=139
  base=171
 end

 spr(corpo,rocket_x,rocket_y,2,2)
 spr(base,rocket_x,rocket_y+16,2,2)
end

function player_hint()
 local perto_npc=nearby_npc()!=nil
 local perto_foguete=near_rocket()

 if msg_timer>0 then
  local tx=x+8-(#msg*2)
  print(msg,tx,y-15,7)
  return
 end

 if perto_npc or perto_foguete then
  if perto_foguete and rocket_stage==5 and not perto_npc then
   print("z",x+6,y-9,11)
  else
   print("❎",x+4,y-8)
  end
 end
end

function hud_draw()
 print("fruit: "..fruit_count,2,2,7)
 print("scrap: "..sucata_count,2,9,7)
 print("rocket: "..rocket_stage.."/5",82,2,10)
end

function ending_draw()
 cls(1)
 print("mission complete",29,12,10)
 spr(anda_frente[ending_frame],56,38,2,2)
 print("your rocket is repaired",15,72,7)
 print("you can finally leave!",20,83,7)
 print("thanks for playing!",25,101,11)
 print("press z to play again",20,117,6)
end
