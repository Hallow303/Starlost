pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
y=63
x=63
idle={0,2,4,6,8}
anda_frente={32,34,36,38,32,40,42,44}
anda_costa={64,66,68,70,64,72,74,76}
anda_lado={96,98,100,102,96,104,106,108}
anim=idle
frame=1
tempo=0
direcao=1
stardust=0
dust_x=100
dust_y=80
dust_coletado=false
cx=0
cy=0
dust={}
maxd=5

for i=1,maxd do
 add(dust,{x=flr(rnd(500)),y=flr(rnd(500)),collected=false})
end
end

function _update()
local nova_anim=idle
local andando=false

if btn(0) then
 x-=1
 nova_anim=anda_lado
 direcao=-1
 andando=true
end

if btn(1) then
 x+=1
 nova_anim=anda_lado
 direcao=1
 andando=true
end

if btn(2) then
 y-=1
 nova_anim=anda_costa
 andando=true
end

if btn(3) then
 y+=1
 nova_anim=anda_frente
 andando=true
end

if nova_anim!=anim then
 anim=nova_anim
 frame=1
 tempo=0
end

tempo+=2

if andando then
 if tempo>=6 then
  tempo=0
  frame+=1
  if frame>#anim then
   frame=1
  end
 end
else
 if tempo>=8 then
  tempo=0
  frame+=1
  if frame>#anim then
   frame=1
  end
 end
end

for d in all(dust) do
 if not d.collected then
  if abs(x-d.x)<9 and abs(y-d.y)<9 then
   d.collected=true
   stardust+=1
  end
 end
end
end

function dcam()
cx=x-63+8
cy=y-63+8
camera(cx,cy)
end

function _draw()
cls()
map()

for d in all(dust) do
 if not d.collected then
  spr(78,d.x,d.y)
 end
end

local sp=anim[frame]
dcam()

if direcao==-1 and anim==anda_lado then
 spr(sp,x,y,2,2,true)
else
 spr(sp,x,y,2,2)
end

print("stardust: "..stardust,cx+5,cy+5)
end
